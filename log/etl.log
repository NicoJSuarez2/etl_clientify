<main>
    <div class="container">
        <div class="text-center">
            <a href="https://clientify.net/">
                <img alt="500" class="img-responsive" src="data:image/jpeg;base64,">
            </a>
        </div>
        <h3 class="text-center text-primary" style="color: #29aede">You cannot perform this action now. Try again later</h3>
        <p class="text-center">
            <button type="button" onclick="window.history.back()" class="btn btn-primary" style="background-color: #29aede; border-color: #29aede">Back.  Atrás</button>
        </p>
    </div>
</main>

